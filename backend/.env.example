# Copia este archivo a backend/.env y pon los valores reales. El .env nunca se versiona.
# En Vercel, estas mismas variables van en Project Settings > Environment Variables.

# Gateway de Grok (espejo de la API de xAI)
XAI_BASE_URL=https://api.reto.pltk.mx/v1
XAI_API_KEY=pk_...
# Medido en la Fase 1: grok-4.6 razona y es lento. Generando la plantilla pasó de 120 s por
# lote; grok-4.20-0309-non-reasoning (también en el gateway) la generó en 18 s.
GROK_MODEL_GENERATE=grok-4.6
# Como juez, grok-4.6 tarda de 4 a 17 s, más que los 8 s que espera el teléfono;
# grok-4.20-0309-non-reasoning responde en 1 a 3 s.
GROK_MODEL_JUDGE=grok-4.6

# Registro de dispositivos
# Código que escribes una vez en la app para registrar el teléfono.
ENROLLMENT_CODE=
# Secreto largo y aleatorio para firmar los tokens de dispositivo. Para generarlo:
#   uv --directory backend run python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_TOKEN_SECRET=

# Historial del agente (S2). En Vercel la pone Neon; en local, el servicio db del compose:
#   postgresql://banano:banano@localhost:5432/banano
# Sin ella el agente funciona, pero no ejecuta intervenciones (no hay cómo confirmarlas).
DATABASE_URL=

# LangGraph Studio (langgraph dev): las ejecuciones no salen de tu PC.
LANGSMITH_TRACING=false

# Opcionales
# Salida estructurada: json_schema | function_calling | json_mode (el gateway acepta las tres)
LLM_STRUCTURED_METHOD=json_schema
# Documentación en /docs: útil en local; en Vercel déjala apagada
ENABLE_DOCS=false
