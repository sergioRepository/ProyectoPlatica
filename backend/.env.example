# Copia este archivo a backend/.env y pon los valores reales. El .env nunca se versiona.
# En Vercel, estas mismas variables van en Project Settings > Environment Variables.

# Gateway de Grok (espejo de la API de xAI)
XAI_BASE_URL=https://api.reto.pltk.mx/v1
XAI_API_KEY=pk_...
GROK_MODEL_GENERATE=grok-4.6
GROK_MODEL_JUDGE=grok-4.6

# Registro de dispositivos (se usan desde la Fase 1)
# Código que escribes una vez en la app para registrar el teléfono.
ENROLLMENT_CODE=
# Secreto largo y aleatorio para firmar los tokens de dispositivo.
DEVICE_TOKEN_SECRET=
