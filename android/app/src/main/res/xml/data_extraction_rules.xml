<?xml version="1.0" encoding="utf-8"?>
<!--
    Nada sale del teléfono por copia en la nube ni por transferencia a otro teléfono (Android 12+).
    La identidad firmada del dispositivo, el plan validado y el historial de razones son de esta
    instalación: copiarlos haría que dos teléfonos compartieran una suscripción y sus créditos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
