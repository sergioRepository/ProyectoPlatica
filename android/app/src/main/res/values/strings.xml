    <string name="onboarding_name_hint">Nombre o apodo. Lo vamos a usar en tu contra.</string>
    <string name="onboarding_name_placeholder">Tu nombre</string>

    <string name="onboarding_goal_title">¿Qué quieres lograr?</string>
    <string name="onboarding_goal_hint">Tu meta principal. Sé concreto: la vamos a citar seguido.</string>
    <string name="onboarding_goal_placeholder">Ser el mejor programador del mundo</string>

    <string name="onboarding_secondary_title">¿Algo más?</string>
    <string name="onboarding_secondary_hint">Metas secundarias. Opcionales, pero dan más material.</string>
