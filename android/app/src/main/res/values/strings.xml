    <!-- Divulgación de Accesibilidad (requisito de Google Play) -->
    <string name="disclosure_title">Antes de activar Accesibilidad</string>
    <string name="disclosure_what">La vida no es un banano usa el servicio de accesibilidad de Android (AccessibilityService API) para una sola cosa: detectar qué app pasa al frente y mostrar la pantalla de bloqueo cuando es una de las que elegiste, en tu horario o durante una sesión de enfoque.</string>
    <string name="disclosure_data_title">Qué dato se usa</string>
    <string name="disclosure_data">Solo el nombre de la app que abres. No leemos el contenido de la pantalla, lo que escribes, tus mensajes ni tus contraseñas.</string>
    <string name="disclosure_use_title">Qué pasa con ese dato</string>
    <string name="disclosure_use">Se usa en tu teléfono para decidir el bloqueo y queda en tu historial. Lo que detecta este servicio sale del teléfono únicamente en funciones que tú autorizas: cuando pides tiempo, el nombre de la app viaja con tu razón para que Peel la evalúe; y si autorizaste ayudarnos a mejorar la app, se registra qué app se bloqueó, si saliste o pediste tiempo y con qué resultado. No lo vendemos ni lo usamos para publicidad.</string>
    <string name="disclosure_accept">Acepto</string>
    <string name="disclosure_decline">No acepto</string>
    <string name="disclosure_declined">Sin tu aceptación no activamos el bloqueo. Puedes aceptarla cuando quieras desde aquí.</string>

